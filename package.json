{
  "name": "beian",
  "private": true,
  "workspaces": [
    "apps/web/ui",
    "apps/web/server"
  ],
  "scripts": {
    "dev": "npm run dev -w beian-server",
    "dev:ui": "npm run dev -w beian-ui",
    "build": "npm run build -w beian-ui",
    "quality": "node scripts/quality/check-complexity.mjs",
    "quality:deep": "node scripts/quality/check-complexity.mjs --deep",
    "test:quality": "node --test scripts/quality/*.test.mjs",
    "verify": "node scripts/quality/verify.mjs",
    "test": "npm run test -w beian-server && npm run test -w beian-ui && cd apps/web/backend && .venv/bin/python -m pytest -q",
    "test:e2e": "npm run test:e2e -w beian-ui",
    "typecheck": "npm run typecheck -w beian-server && npm run build -w beian-ui"
  },
  "engines": {
    "node": ">=20"
  },
  "version": "0.25.0"
}
