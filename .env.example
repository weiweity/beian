# 复制到本机，不要提交真实值。
# 也可以登录后打开顶栏「设置」填写；设置页写入 data/settings*.json，覆盖这里。
# cp .env.example apps/web/backend/.env.secrets
# cp .env.example 里的百度段到 apps/web/backend/.env.baidu

# 百度 OCR（与代码一致；BAIDU_API_KEY 仍可作别名）
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_API=accurate

# MiniMax（可选）
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_ENABLED=false

# 飞书网页应用（身份）。密钥只放本机，不要提交
FEISHU_APP_ID=cli_aa0ebd6422385ce0
FEISHU_APP_SECRET=
WB_PUBLIC_BASE=https://www.jianghua.site
FEISHU_REDIRECT_URI=https://www.jianghua.site/api/auth/feishu/callback
# 逗号分隔 ou_… ；也可写在 data/users.json 的 open_id 字段
# FEISHU_ALLOW_OPEN_IDS=

# 飞书推送（lark-cli，不是登录）
FEISHU_ENABLED=false
FEISHU_OPEN_ID=
FEISHU_DISPLAY_NAME=
FEISHU_AS=bot

# 权限：未知显示名一律 403。公网再加 WB_PUBLIC=1（关闭显示名登录）
AUTH_REQUIRE_KNOWN=true
# WB_DEV_DISPLAY_LOGIN=true
# WB_PUBLIC=false

# 数据目录。生产必须设到仓库外，例如 C:\supply\data
# WB_DATA_DIR=

# CORS，逗号分隔。禁止 *
# WB_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8787

# 可选：本机评测样本目录（不进 git）
# WB_SAMPLES_DIR=

# 上传上限 MB
# WB_MAX_UPLOAD_MB=200
