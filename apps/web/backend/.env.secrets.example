# 复制为 .env.secrets 并填入真实值（chmod 600）
# cp .env.secrets.example .env.secrets && chmod 600 .env.secrets
# 切勿提交到 git

# MiniMax
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_ENABLED=true

# 飞书个人推送（lark-cli）
FEISHU_ENABLED=true
FEISHU_OPEN_ID=ou_xxxxxxxx
FEISHU_DISPLAY_NAME=
FEISHU_AS=bot

# 权限：true 时仅 users.json 登记名可登录
AUTH_REQUIRE_KNOWN=false
