# 复制为 .env.secrets 并填入真实值（chmod 600）
# cp .env.secrets.example .env.secrets && chmod 600 .env.secrets
# 切勿提交到 git

# MiniMax
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_ENABLED=true

# 飞书网页应用身份。Secret 只放这一份本机文件
FEISHU_APP_ID=cli_aa0ebd6422385ce0
FEISHU_APP_SECRET=
WB_PUBLIC_BASE=https://www.jianghua.site
FEISHU_REDIRECT_URI=https://www.jianghua.site/api/auth/feishu/callback
# FEISHU_ALLOW_OPEN_IDS=ou_xxxxxxxx

# 飞书个人推送（lark-cli，不是登录）
FEISHU_ENABLED=false
FEISHU_OPEN_ID=
FEISHU_DISPLAY_NAME=
FEISHU_AS=bot

# 权限：true 时仅 users.json 登记名可登录
AUTH_REQUIRE_KNOWN=true
WB_DEV_DISPLAY_LOGIN=true
WB_PUBLIC=false
# WB_DATA_DIR=
